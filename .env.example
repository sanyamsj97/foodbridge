# ---------- FoodBridge configuration ----------
NODE_ENV=production
PORT=3000
APP_URL=https://your-foodbridge-domain.example
# Set to 1 when running behind a reverse proxy / PaaS (Render, Railway, Nginx) so HTTPS & client IPs are detected.
TRUST_PROXY=1

# Database: "firestore" (production, Firebase Spark free plan) or "memory" (local dev/tests only)
DB_DRIVER=firestore
# Firebase service account (Project settings → Service accounts → Generate new private key).
# Use ONE of these:
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json
# FIREBASE_SERVICE_ACCOUNT_BASE64=<base64 of the JSON file – handy on PaaS hosts>
FIREBASE_PROJECT_ID=your-firebase-project-id

# Secrets – generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
OTP_ENCRYPTION_KEY=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# Optional: restrict admin login/API to these IPs (comma-separated). Leave empty to allow any.
ADMIN_IP_ALLOWLIST=

# Optional: Firebase Cloud Messaging web push (free). Project settings → General → Web app, and
# Cloud Messaging → Web Push certificates (VAPID key).
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_VAPID_KEY=

# Local development only (DB_DRIVER=memory): persist data to a JSON file between restarts
# DEV_DB_FILE=./data/dev-db.json
