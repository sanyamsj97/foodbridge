rules_version = '2';
// FoodBridge: ALL data access goes through the Node.js server (Firebase Admin SDK, which bypasses
// these rules). Direct client access to Firestore is denied, so identity documents, OTPs and
// private contact details can never be read from a browser with the public Firebase config.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
